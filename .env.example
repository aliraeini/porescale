# Optional settings, copy to .env (git-ignored). Defaults, if not set here:
#   MS_INST=<this folder>/inst  msBilDir=<this folder>/build  MS_TEST_DIR=<this folder>/test_runs  (these must be inside this folder)
#   ms3rd=pkgs  POCKETPY_DIR=$ms3rd/pocketpy  HYPRE_SRC=$ms3rd/hypre  FOAMXM_SRC=$ms3rd/foamxm  IMAGE3KIT_DIR=<src>/image3kit
# Do not leave a variable empty (e.g. MS_INST=), delete or comment out the line instead.
# MS_ALLOW_OUTSIDE=1   # needed if the folders below are outside this folder (e.g. shared with another repo)
# MS_INST=/path/inside/this/folder
# msBilDir=/path/inside/this/folder/build
# MS_TEST_DIR=/path/inside/this/folder/test_runs
# ms3rd=/path/to/pkgs
# POCKETPY_DIR=/path/to/pocketpy
# HYPRE_SRC=/path/to/hypre
# FOAMXM_SRC=/path/to/foamxm
# IMAGE3KIT_DIR=/path/to/image3kit
# avoid AMD OpenCL ICD crashes during MPI initialization:
HWLOC_COMPONENTS=-opencl
