# Optional settings, copy to .env (git-ignored). Defaults, if not set here:
#   MS_INST=<this folder>  msBilDir=$MS_INST/build  MS_TEST_DIR=$MS_INST/test_runs  (these must be inside this folder)
#   ms3rd=pkgs  POCKETPY_DIR=$ms3rd/pocketpy
# Do not leave a variable empty (e.g. MS_INST=), delete or comment out the line instead.
# MS_INST=/path/inside/this/folder
# msBilDir=/path/inside/this/folder/build
# MS_TEST_DIR=/path/inside/this/folder/test_runs
# ms3rd=/path/to/pkgs
# POCKETPY_DIR=/path/to/pocketpy
# avoid AMD OpenCL ICD crashes during MPI initialization:
HWLOC_COMPONENTS=-opencl
